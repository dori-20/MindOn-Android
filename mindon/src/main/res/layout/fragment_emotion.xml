<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

    <!-- 일기 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewEmotion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        android:scrollbars="vertical"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnWriteEmotion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- + 오늘의 일기쓰기 버튼 -->
    <Button
        android:id="@+id/btnWriteEmotion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+ 오늘의 감정일기 쓰기"
        android:layout_margin="16dp"
        android:backgroundTint="@color/moss_green"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewEmotion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>